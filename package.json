{
  "name": "mtg-deck-validator",
  "version": "0.1.0",
  "description": "Validate Magic: The Gathering decklists against constructed, Commander, and Duel Commander rules.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Calatayud Digital Solutions <info@calatayud-digital-solutions.es>",
  "homepage": "https://manaforge.tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/Calatayud-Digital-Solutions/mtg-deck-validator"
  },
  "license": "MIT",
  "keywords": [
    "mtg",
    "magic-the-gathering",
    "magic",
    "deck",
    "validator",
    "commander",
    "duel-commander",
    "standard",
    "pauper",
    "scryfall",
    "banlist",
    "legality"
  ],
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
